# =============================================================================
# .env.example — committed template. Copy to `.env` and fill in real values.
# `.env` itself is gitignored and must never be committed.
# =============================================================================

# --- App / environment ---
APP_ENV=development                     # one of: development | test | production, used to toggle behavior (docs, debug, etc.)
APP_NAME="AI Interview Intelligence Platform"  # human-readable app name, used in logs/titles
API_HOST=0.0.0.0                        # interface FastAPI/uvicorn binds to inside its container/host
API_PORT=8000                           # documented default; uvicorn still needs `--port` (it does not read this)
FRONTEND_ORIGIN=http://localhost:5173   # CORS allow-list; localhost and 127.0.0.1 for the same port are both allowed

# --- Database (Postgres + pgvector) ---
POSTGRES_USER=aiip_user                 # postgres role used by the app and by docker-compose to create the db
POSTGRES_PASSWORD=change_me_locally     # postgres password; replace with a real secret in your local .env
POSTGRES_DB=aiip_db                     # database name created inside the postgres container
POSTGRES_HOST=localhost                 # hostname of the postgres service (use service name "db" when running app in docker-compose too)
POSTGRES_PORT=5432                      # port postgres listens on (mapped host:container in docker-compose)
# Full async SQLAlchemy DSN assembled from the pieces above; keep both in sync if you change the pieces.
DATABASE_URL=postgresql+asyncpg://aiip_user:change_me_locally@localhost:5432/aiip_db

# --- Redis / ARQ job queue ---
REDIS_HOST=localhost                    # hostname of the redis service (use service name "redis" inside docker-compose network)
REDIS_PORT=6379                         # port redis listens on
REDIS_URL=redis://localhost:6379/0      # full redis DSN used by ARQ's RedisSettings and the FastAPI app

# --- Auth (JWT + Argon2id) ---
JWT_SECRET_KEY=change_this_to_a_long_random_string   # HMAC signing secret for access/refresh JWTs; rotate in production
JWT_ALGORITHM=HS256                     # signing algorithm used by PyJWT
ACCESS_TOKEN_EXPIRE_MINUTES=15          # short-lived access token lifetime
REFRESH_TOKEN_EXPIRE_DAYS=7             # longer-lived refresh token lifetime, rotated on use

# --- Rate limiting (slowapi) ---
RATE_LIMIT_DEFAULT=100/minute           # default slowapi limit string applied to most routes

# --- LLM provider (ml/llm/provider.py) ---
LLM_PROVIDER=ollama                     # one of: ollama | openai_compat, selects which backend implementation is used
OLLAMA_BASE_URL=http://localhost:11434  # local Ollama server address inside WSL2
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M   # quantized model tag pulled via `ollama pull`, sized for 8GB VRAM
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1   # base URL for any OpenAI-compatible hosted API
OPENAI_COMPAT_API_KEY=                  # API key for the hosted provider; leave blank when using Ollama only
OPENAI_COMPAT_MODEL=gpt-4o-mini         # model name to request from the hosted provider

# --- Local blob storage (resumes, audio) ---
STORAGE_ROOT=./data/blobs               # local filesystem root for uploaded resumes and interview audio files

# --- Whisper / speech pipeline ---
WHISPER_MODEL=medium.en                 # faster-whisper model size/tag; distil-large-v3 also fits an 8GB GPU
WHISPER_DEVICE=cuda                     # cuda | cpu, device faster-whisper loads onto
WHISPER_COMPUTE_TYPE=int8_float16       # quantized compute type balancing speed/accuracy on 8GB VRAM
